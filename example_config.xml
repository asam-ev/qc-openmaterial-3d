<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<Config>

    <Param name="InputFile" value="/path/to/example_asset.xoma" />

    <CheckerBundle application="xomBundle">
        <Param name="resultFile" value="xom_bundle_report.xqar" />
        <Checker checkerId="check_asam.net:xom:1.0.0:general.valid_json_document" maxLevel="1" minLevel="3" />
        <Checker checkerId="check_asam.net:xom:1.0.0:general.version_is_defined" maxLevel="1" minLevel="3" />
        <Checker checkerId="check_asam.net:xom:1.0.0:general.valid_schema" maxLevel="1" minLevel="3" />
        <Checker checkerId="check_asam.net:xom:1.0.0:general.uris_exist" maxLevel="1" minLevel="3" />
        <Checker checkerId="check_asam.net:xom:1.0.0:xoma.material_textures_exist" maxLevel="1" minLevel="3" />
        <Checker checkerId="check_asam.net:xom:1.0.0:xoma.texture_assignment_requires_mapping" maxLevel="1" minLevel="3" />
        <Checker checkerId="check_asam.net:xom:1.0.0:xoma.vehicle_class_data_defined" maxLevel="1" minLevel="3" />
        <Checker checkerId="check_asam.net:xom:1.0.0:xoma.human_class_data_defined" maxLevel="1" minLevel="3" />
        <Checker checkerId="check_asam.net:xom:1.1.0:xoma.light_definition_nodes_exist" maxLevel="1" minLevel="3" />
        <Checker checkerId="check_asam.net:xom:1.1.0:xoma.emissive_light_nodes_exist" maxLevel="1" minLevel="3" />
        <Checker checkerId="check_asam.net:xom:1.0.0:xompt.tables_sorted_correctly" maxLevel="1" minLevel="3" />
        <Checker checkerId="check_asam.net:xom:1.0.0:xomp.look_up_tables_unique_wavelengths" maxLevel="1" minLevel="3" />

    </CheckerBundle>

    <ReportModule application="TextReport">
        <Param name="strInputFile" value="Result.xqar" />
        <Param name="strReportFile" value="Report.txt" />
    </ReportModule>

</Config>